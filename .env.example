# ============================================================
# LLM Provider Selection
# Options: claude | openai | azure | gemini
# Default: claude
# ============================================================
LLM_PROVIDER=claude

# ============================================================
# Anthropic Claude  (active when LLM_PROVIDER=claude)
# ============================================================
ANTHROPIC_API_KEY=sk-ant-your-key-here
CLAUDE_MODEL=claude-sonnet-4-6

# ============================================================
# OpenAI  (active when LLM_PROVIDER=openai)
# Also used as the embedding fallback when LLM_PROVIDER=claude
# ============================================================
OPENAI_API_KEY=sk-your-key-here
OPENAI_MODEL=gpt-4o

# ============================================================
# Azure OpenAI  (active when LLM_PROVIDER=azure)
# ============================================================
AZURE_OPENAI_API_KEY=your-azure-key-here
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_API_VERSION=2024-08-01-preview
AZURE_OPENAI_DEPLOYMENT_NAME=gpt-4o
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-large

# ============================================================
# Google Gemini  (active when LLM_PROVIDER=gemini)
# ============================================================
GOOGLE_API_KEY=your-google-api-key-here
GEMINI_MODEL=gemini-2.0-flash

# ============================================================
# PostgreSQL
# ============================================================
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/citizen_service
DATABASE_URL_SYNC=postgresql://user:password@localhost:5432/citizen_service

# ============================================================
# ChromaDB
# ============================================================
CHROMA_HOST=localhost
CHROMA_PORT=8000
CHROMA_COLLECTION_NAME=citizen_knowledge

# ============================================================
# Application
# ============================================================
APP_ENV=development
SECRET_KEY=your-secret-key-here
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ============================================================
# Memory
# ============================================================
SESSION_TTL_SECONDS=3600
MAX_HISTORY_TURNS=10
